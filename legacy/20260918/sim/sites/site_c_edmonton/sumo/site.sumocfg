<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <input>
    <net-file value="network.net.xml"/>
    <route-files value="routes.rou.xml"/>
    <additional-files value="additional.add.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="1800"/>
    <step-length value="1"/>
  </time>
  <processing>
    <ignore-route-errors value="true"/>
  </processing>
</configuration>
