# Environment variables consumed by the framework.
# Copy this file to a shell profile / CI secret store — the code reads the OS
# environment directly (it does NOT auto-load a `.env` file).

# ---------------------------------------------------------------------------
# LLM (OpenAI-compatible chat-completions endpoint)
#   - `base_url` and `model` are set in config/phase3_config.yaml (not here).
#   - The API key is read from this env var first, then from
#     ~/.dsh/.credentials.yaml (CORP_AI_API_KEY: ...).
# ---------------------------------------------------------------------------
CORP_AI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# BlueSky source checkout (github.com/TUDelft-CNS-ATM/bluesky).
#   If unset, the adapter falls back to a machine-specific default path.
# ---------------------------------------------------------------------------
BLUESKY_REPO=/path/to/bluesky
